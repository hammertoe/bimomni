# Qwen3-Omni Barbados DAPT training container.
# Pinned to the exact runtime used in V3 smoke + production:
#   - torch 2.7.1+cu126
#   - ms-swift 4.4.x
#   - transformers 5.8.1
#   - tokenizers >=0.22.0,<=0.23.0
#   - peft 0.18.1 (PEFT 0.19 splits target_modules across regex characters)
#   - fsspec 2026.2.0 (datasets caps <=2026.2.0)
#   - flash-attn 2.7.4.post1 (built in devel, copied into the runtime image)
#   - torchvision 0.22.1+cu126 (matches torch 2.7.1; 0.24.x targets torch 2.9)
#   - qwen_omni_utils (text-only shim: upstream import chain breaks torch 2.7.1)
#
# Build (linux/amd64, emulated on Apple Silicon):
#   docker buildx build --platform linux/amd64 \
#     -f hf_space/Dockerfile -t ghcr.io/hammertoe/qwen3-omni-barbados-dapt:v3 .
#
# Run modes (default: train --budget 12):
#   docker run --rm --gpus all --env HF_TOKEN ... ghcr.io/.../qwen3-omni-barbados-dapt:v3
#   docker run --rm --gpus all ... :v3 doctor
#   docker run --rm --gpus all ... :v3 smoke
#   docker run --rm --gpus all ... :v3 sync-once

FROM pytorch/pytorch:2.7.1-cuda12.6-cudnn9-devel AS flash-builder

ENV PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1

RUN pip install --upgrade pip wheel \
    && pip wheel --no-cache-dir --no-build-isolation --no-deps \
        --wheel-dir /wheels "flash-attn==2.7.4.post1"


FROM python:3.11-slim-bookworm AS runtime

ENV DEBIAN_FRONTEND=noninteractive \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PYTHONPATH=/workspace \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    PIP_NO_CACHE_DIR=1 \
    ENABLE_AUDIO_OUTPUT=0

WORKDIR /workspace

RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends ca-certificates \
    && rm -rf /var/lib/apt/lists/*

RUN pip install --upgrade pip wheel

# PyTorch's CUDA wheel dependencies are deliberately split across layers.
# The official PyTorch runtime image stores them in one 3.32 GB layer, which
# GHCR repeatedly rejects mid-upload. These are the exact torch 2.7.1+cu126
# dependency versions and remain ABI-identical to the FlashAttention builder.
RUN pip install --no-cache-dir --no-deps \
    "nvidia-cuda-nvrtc-cu12==12.6.77" \
    "nvidia-cuda-runtime-cu12==12.6.77" \
    "nvidia-cuda-cupti-cu12==12.6.80" \
    "nvidia-nvtx-cu12==12.6.77"
RUN pip install --no-cache-dir --no-deps "nvidia-cublas-cu12==12.6.4.1"
RUN pip install --no-cache-dir --no-deps "nvidia-cudnn-cu12==9.5.1.17"
RUN pip install --no-cache-dir --no-deps --resume-retries 20 --timeout 120 \
    "nvidia-cufft-cu12==11.3.0.4" \
    "nvidia-curand-cu12==10.3.7.77"
RUN pip install --no-cache-dir --no-deps --resume-retries 20 --timeout 120 \
    "nvidia-cusolver-cu12==11.7.1.2" \
    "nvidia-cusparse-cu12==12.5.4.2" \
    "nvidia-cusparselt-cu12==0.6.3"
RUN pip install --no-cache-dir --no-deps --resume-retries 20 --timeout 120 \
    "nvidia-nccl-cu12==2.26.2"
RUN pip install --no-cache-dir --no-deps --resume-retries 20 --timeout 120 \
    "nvidia-nvjitlink-cu12==12.6.85" \
    "nvidia-cufile-cu12==1.11.1.6"
RUN pip install --no-cache-dir --no-deps --resume-retries 20 --timeout 120 \
    "triton==3.3.1"
RUN pip install --no-cache-dir --no-deps --resume-retries 20 --timeout 120 \
    --index-url https://download.pytorch.org/whl/cu126 \
    "torch==2.7.1"
RUN pip install --no-cache-dir \
    filelock fsspec jinja2 networkx sympy typing-extensions

# Install ms-swift with its real runtime dependencies. We pin only what the V3
# recipe actually exercises; ms-swift pulls in its own versions of overlapping
# packages (safetensors, transformers-stream-generator, modelscope, etc).
RUN pip install --no-cache-dir "ms-swift==4.4.2"

# Pin the exact versions that V3 was validated against and override anything
# ms-swift pulled that does not match.
RUN pip install --no-cache-dir \
    "transformers==5.8.1" \
    "tokenizers>=0.22.0,<=0.23.0" \
    "peft==0.18.1" \
    "datasets<4.8.5" \
    "bitsandbytes" \
    "huggingface_hub>=0.34,<2.0" \
    "accelerate" \
    "addict" "attrdict" "binpacking" "cpm-kernels" "dacite" "fastapi" \
    "gradio<6.0,>=3.40.0" "importlib-metadata" "json-repair" "matplotlib" \
    "modelscope>=1.23" "nltk" "openai" "oss2" "pandas" "rouge" "safetensors" \
    "scipy" "sentencepiece" "simplejson>=3.3.0" "tensorboard" "tiktoken" \
    "transformers-stream-generator" "trl<1.0,>=0.15" "uvicorn"

RUN pip install --no-cache-dir --force-reinstall --no-deps "fsspec==2026.2.0" \
    && pip install --no-cache-dir --no-deps --resume-retries 20 --timeout 120 \
        --index-url https://download.pytorch.org/whl/cu126 "torchvision==0.22.1" \
    && pip install --no-cache-dir --no-deps --resume-retries 20 --timeout 120 \
        "qwen_omni_utils==0.0.9" "decord" "soundfile" \
    && rm -rf /usr/local/lib/python3.11/site-packages/qwen_omni_utils

# qwen_omni_utils import-time chain (torchvision / audioread / av / librosa)
# breaks against torch 2.7.1 (torchvision 0.24.x bug) or downgrades numpy via
# numba. DAPT is text-only, so replace the package with a pure-Python shim;
# the real dist-info stays so ms-swift's version check passes.
COPY hf_space/image_assets/qwen_omni_utils_shim/ \
    /usr/local/lib/python3.11/site-packages/qwen_omni_utils/

COPY --from=flash-builder /wheels/flash_attn-*.whl /tmp/wheels/
RUN pip install --no-cache-dir /tmp/wheels/flash_attn-*.whl \
    && rm -rf /tmp/wheels

COPY hf_space /workspace/hf_space

RUN python -c "import flash_attn, peft, swift, torch, torchvision, transformers; from qwen_omni_utils import vision_process; assert torch.__version__ == '2.7.1+cu126'; assert torchvision.__version__ == '0.22.1+cu126'; assert transformers.__version__ == '5.8.1'; assert peft.__version__ == '0.18.1'; assert swift.__version__ == '4.4.2'; assert flash_attn.__version__ == '2.7.4.post1'; assert vision_process.FPS == 2.0; assert callable(vision_process.fetch_image)"

ENTRYPOINT ["python", "-m", "hf_space.supervisor"]
CMD ["train", "--budget", "12"]
